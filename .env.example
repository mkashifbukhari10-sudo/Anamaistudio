# DEEPSEEK_API_KEY: Required. The only AI provider used for story/text generation.
# Server-side only - it must never reach the browser bundle.
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# DEEPSEEK_BASE_URL (optional): override the API host. Defaults to https://api.deepseek.com
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Signs the login session cookie. REQUIRED in production.
# Anyone holding this value can forge a session for any account, so keep it
# out of the repo. Generate one with: npm run generate-secret
SESSION_SECRET="MY_SESSION_SECRET"

# APP_USERS (optional): overrides the account list in src/server/auth/users.ts.
# Set this in production to keep real credentials out of git. JSON array of
# {id, username, displayName, passwordHash}; hash via: npm run hash-password -- "pw"
# APP_USERS='[{"id":"u_1","username":"admin","displayName":"Studio Admin","passwordHash":"scrypt$..."}]'
