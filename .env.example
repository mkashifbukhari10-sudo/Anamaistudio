# GEMINI_API_KEY: Required. The PRIMARY provider for story and scene generation,
# and the only one with an image endpoint, so the Character Reference Studio
# needs it to produce reference images rather than prompt-only.
# Server-side only - it must never reach the browser bundle.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY (optional): FALLBACK provider. Used only when Gemini fails
# recoverably - rate limit, quota, timeout, unavailable. A bad Gemini key or a
# denied project is terminal and is NOT failed over, so a misconfiguration is
# reported instead of silently costing money on the other vendor.
# Leave unset to run on Gemini alone.
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# AI_PROVIDER (optional): overrides which registered provider is primary.
# Values: "gemini" (default) or "deepseek".
# AI_PROVIDER="gemini"

# DEEPSEEK_BASE_URL (optional): override the API host. Defaults to https://api.deepseek.com
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Signs the login session cookie. REQUIRED in production.
# Anyone holding this value can forge a session for any account, so keep it
# out of the repo. Generate one with: npm run generate-secret
SESSION_SECRET="MY_SESSION_SECRET"

# APP_USERS (optional): overrides the account list in src/server/auth/users.ts.
# Set this in production to keep real credentials out of git. JSON array of
# {id, username, displayName, passwordHash}; hash via: npm run hash-password -- "pw"
# APP_USERS='[{"id":"u_1","username":"admin","displayName":"Studio Admin","passwordHash":"scrypt$..."}]'
