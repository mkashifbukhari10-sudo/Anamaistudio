# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Gemini is the only active provider: it serves all text/story generation and
# all character reference image generation. Server-side only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Signs the login session cookie. REQUIRED in production.
# Anyone holding this value can forge a session for any account, so keep it
# out of the repo. Generate one with: npm run generate-secret
SESSION_SECRET="MY_SESSION_SECRET"

# APP_USERS (optional): overrides the account list in src/server/auth/users.ts.
# Set this in production to keep real credentials out of git. JSON array of
# {id, username, displayName, passwordHash}; hash via: npm run hash-password -- "pw"
# APP_USERS='[{"id":"u_1","username":"admin","displayName":"Studio Admin","passwordHash":"scrypt$..."}]'
