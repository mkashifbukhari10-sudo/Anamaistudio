# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Optional. Enables Groq as the text-generation fallback provider.
# When unset, Groq is skipped entirely and Gemini behaves exactly as before.
# Server-side only - never exposed to the browser bundle.
GROQ_API_KEY="MY_GROQ_API_KEY"

# Optional AI routing controls (all have safe defaults):
#   AI_PROVIDER              - primary provider id: "gemini" (default) or "groq"
#   GROQ_TEXT_MODELS         - comma-separated Groq model fallback chain
#   GROQ_BASE_URL            - override the Groq API base URL
#   AI_PROVIDER_COOLDOWN_MS  - skip a failed provider for this long (default 60000)

# CODECRAFT_API_KEY: Optional. Enables CodeCraft API as the third text provider.
# Key format: cc_ followed by 48 characters. Server-side only.
# When unset, CodeCraft is skipped entirely and failover behaves as before.
CODECRAFT_API_KEY="MY_CODECRAFT_API_KEY"

# Optional CodeCraft controls:
#   CODECRAFT_TEXT_MODELS - comma-separated model fallback chain
#                           (default: deepseek-v4-pro-0813,gpt-5.6-luna,qwen3.8-27b)
#   CODECRAFT_BASE_URL    - override the API base URL (default https://codecraftapi.com/v1)
#   CODECRAFT_MAX_TOKENS  - raise the output cap above the API default of 8192

# OPENROUTER_API_KEY: Optional. Enables OpenRouter as the fourth text provider.
# Server-side only. When unset, OpenRouter is skipped entirely.
# Free (:free) models are limited to 20 requests/minute and 50 requests/day
# (1,000/day once $10 of credit has ever been purchased).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# Optional OpenRouter controls:
#   OPENROUTER_TEXT_MODELS - comma-separated model fallback chain (default:
#     dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free)
#   OPENROUTER_BASE_URL    - override the API base URL (default https://openrouter.ai/api/v1)
#   OPENROUTER_MAX_TOKENS  - explicit output token cap
#   OPENROUTER_SITE_URL    - optional HTTP-Referer attribution header
#   OPENROUTER_APP_TITLE   - optional X-Title attribution header
